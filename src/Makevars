CXX_STD = CXX17
# -I. lets rcpp_bindings.cpp include "core/clr_core.hpp"; core/clr_core.o is
# built from the pure-C++ subdirectory (kept out of R's default src glob).
PKG_CPPFLAGS = -I.
# OpenMP for the mi_matrix() pair loop (core). R supplies the portable flags
# via SHLIB_OPENMP_CXXFLAGS on supported platforms.
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS)
OBJECTS = rcpp_bindings.o RcppExports.o core/clr_core.o
